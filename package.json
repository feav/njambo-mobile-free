{
  "name": "njambo-mobile-free",
  "version": "1.0.0",
  "author": "ARS Group",
  "homepage": "https://ars-global.com/",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/write-build-info.mjs",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "start:test": "ng serve --configuration test --host 0.0.0.0 --port 4201",
    "prebuild": "node scripts/write-build-info.mjs",
    "build": "ng build --configuration production",
    "prebuild:production": "node scripts/write-build-info.mjs",
    "build:production": "ng build --configuration production",
    "prebuild:preproduction": "node scripts/write-build-info.mjs",
    "build:preproduction": "ng build --configuration preproduction && node scripts/verify-api-target.mjs preproduction",
    "test": "ng test --watch=false"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "dependencies": {
    "@angular/animations": "20.3.26",
    "@angular/common": "20.3.26",
    "@angular/compiler": "20.3.26",
    "@angular/core": "20.3.26",
    "@angular/forms": "20.3.26",
    "@angular/platform-browser": "20.3.26",
    "@angular/platform-browser-dynamic": "20.3.26",
    "@angular/router": "20.3.26",
    "@angular/service-worker": "^20.3.26",
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@ionic/angular": "8.8.13",
    "@stomp/stompjs": "^7.3.0",
    "rxjs": "~7.8.2",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.32",
    "@angular/cli": "20.3.32",
    "@angular/compiler-cli": "20.3.26",
    "@ionic/angular-toolkit": "12.3.0",
    "@types/jasmine": "~5.1.9",
    "@types/node": "^22.15.0",
    "@types/sockjs-client": "^1.5.4",
    "jasmine-core": "~5.10.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.3"
  },
  "description": "Njambo, jeux de cartes et jetons virtuels."
}
